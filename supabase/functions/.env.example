# Local secrets for the Supabase edge runtime (loaded by `supabase start` / `supabase functions
# serve --env-file supabase/functions/.env`). Copy to supabase/functions/.env and fill in.
#
# Leave RESEND_API_KEY blank to make send-invitation-email a no-op — recommended for local dev
# and CI (no Resend account needed; workspace invitations still work via the in-app flow and the
# copy-link).

# onboarding@resend.dev is Resend's shared sandbox sender — works with any key, no domain
# verification. The hosted value is `CrowScribe <invites@send.crowscribe.space>` (a verified domain).
RESEND_API_KEY=
RESEND_FROM=CrowScribe <onboarding@resend.dev>
SITE_URL=http://127.0.0.1:3000
