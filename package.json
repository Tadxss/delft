{
  "name": "crowscribe",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.10.12",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": "22.x"
  },
  "pnpm": {
    "overrides": {
      "@tiptap/pm": "3.30.5",
      "prosemirror-view": "1.42.3"
    }
  },
  "dependencies": {
    "@blocknote/server-util": "^0.54.0"
  }
}
