# Copy to .env.local and fill in with your local `supabase start` output (API URL / anon key), or
# your hosted project's URL/anon key.

# Local Supabase stack default (see supabase/config.toml [api] section) — `supabase start` prints
# the matching anon key to paste below.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Error observability (see docs/ARCHITECTURE.md's Build Order for why) — Sentry project Settings ->
# Client Keys (DSN). Optional locally; without it, Sentry.init() just no-ops.
NEXT_PUBLIC_SENTRY_DSN=

# Cloudflare Turnstile site key for the login-page CAPTCHA. Use the always-pass TEST key locally
# (below); the widget is hidden entirely if this is unset. Hosted uses the real key from your
# Cloudflare Turnstile dashboard (and the matching secret goes in Supabase Auth settings).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
