{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/block-master-git-writes.js",
            "shell": "bash",
            "statusMessage": "Checking git branch before commit/push..."
          }
        ]
      }
    ]
  }
}
