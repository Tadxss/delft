# Copy to .env (repo root, gitignored) — the Supabase CLI reads env() substitutions used in
# supabase/config.toml from here when you run `npx supabase start`.

# Google OAuth client, from a free Google Cloud Console OAuth 2.0 Client ID
# (console.cloud.google.com > APIs & Services > Credentials). For local dev, add
# http://127.0.0.1:54321/auth/v1/callback as an authorized redirect URI on that client.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Cloudflare Turnstile secret key for the login-page CAPTCHA (supabase/config.toml
# [auth.captcha]). Local/CI use Turnstile's always-pass TEST secret:
SUPABASE_AUTH_CAPTCHA_SECRET=1x0000000000000000000000000000000AA
